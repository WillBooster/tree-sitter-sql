{
  "name": "@willbooster/tree-sitter-sql",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "SQL grammars (SQLite) for tree-sitter",
  "keywords": [
    "parsing",
    "sql",
    "sqlite",
    "tree-sitter"
  ],
  "license": "MIT",
  "author": "WillBooster Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/tree-sitter-sql.git"
  },
  "scripts": {
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@willbooster/oxlint-config": "1.4.9",
    "@willbooster/wb": "23.3.0",
    "lefthook": "2.2.2",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  }
}
