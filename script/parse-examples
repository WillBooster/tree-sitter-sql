#!/usr/bin/env bash

# Parses real-world SQL files cloned into examples/ with each grammar, and rewrites
# script/known-failures/<dialect>.txt, the list of files that fail to parse. With --check, fails instead when a list
# would change. Optional dialect arguments restrict the run to those dialects.

set -euo pipefail

check=false
if [[ ${1-} == --check ]]; then
  check=true
  shift
fi

# Each example repository is pinned to a commit so that the list of failures changes only with the grammar.
# Moving a pin requires running this script without --check to update the list. The checkouts under
# examples/ belong to this script: local changes there are discarded so that the pinned files are parsed.
# The hosts occasionally answer with a server error, so each fetch is retried in place.
clone() {
  local dir=examples/$1
  if [[ $(git -C "$dir" rev-parse HEAD 2> /dev/null) != "$3" ]]; then
    if [[ ! -d $dir/.git ]]; then
      rm -rf "$dir"
      git init -q "$dir"
    fi
    local attempt
    for attempt in 1 2 3 4; do
      if git -C "$dir" fetch -q --depth=1 "$2" "$3"; then
        break
      fi
      if [[ $attempt == 4 ]]; then
        return 1
      fi
      sleep $((attempt * 15))
    done
    git -C "$dir" checkout -q -f --detach "$3"
  fi
  git -C "$dir" reset -q --hard
  git -C "$dir" clean -q -ffdx
}

cd "$(dirname "$0")/.."

all_dialects=$(node -e 'const {grammars} = require("./tree-sitter.json"); console.log(grammars.map(({name}) => name).join("\n"));')
for arg in "$@"; do
  if ! grep -qxF -- "$arg" <<< "$all_dialects"; then
    echo "Unknown dialect: $arg (expected one of: $(tr '\n' ' ' <<< "$all_dialects"))" >&2
    exit 1
  fi
done
selected=("$@")
should_run() {
  if [[ ${#selected[@]} -eq 0 ]]; then
    return 0
  fi
  local item
  for item in "${selected[@]}"; do
    if [[ $item == "$1" ]]; then
      return 0
    fi
  done
  return 1
}

clone chinook https://github.com/lerocha/chinook-database 7f67772503d71ba90f19283c38e93923addb43fa
clone quartz https://github.com/quartz-scheduler/quartz 741ccc3cff96a32e4ab07d69624eaaa534624245
clone spring-batch https://github.com/spring-projects/spring-batch 86b656768ab09cf5d2b1b07f650a987652cd3e1b
if should_run sqlite; then
  clone anki https://github.com/ankitects/anki 641aae52f59b9d9579817cfe80d3020059b5da46
  clone northwind https://github.com/jpwhite3/northwind-SQLite3 4f56e7f5906dfd23b25244c5bfe8fb5da6402efd
fi
if should_run sqlite || should_run postgresql; then
  clone synapse https://github.com/element-hq/synapse 4a8532b2597ce1e41d69b550559bd6f53be835f9
fi
if should_run mysql; then
  clone mysql-test-db https://github.com/datacharmer/test_db e324b56193ca506ab7cc1ab143a9153d8c4535d7
fi
if should_run oracle; then
  clone oracle-samples https://github.com/oracle-samples/db-sample-schemas 6660bad68c07bd143430ace58565b3f727e17263
fi

output=$(mktemp)
failures=$(mktemp)
files=$(mktemp)
mkdir -p .tmp/parse-examples script/known-failures
# Runs in the same checkout may overlap, so each builds the parser into a file of its own.
parsers=$(mktemp -d .tmp/parse-examples/run.XXXXXX)
trap 'rm -rf "$output" "$failures" "$files" "$parsers"' EXIT

# Parses the files matching the given `find` expressions with one grammar; `parse --grammar-path` would recompile the
# parser for every file.
parse() {
  local grammar=$1
  shift
  local known_file="script/known-failures/$grammar.txt"
  : > "$failures"
  find "$@" -type f -print | LC_ALL=C sort > "$files"
  script/tree-sitter build -o "$parsers/$grammar" "$grammar"
  # The CLI exits non-zero whenever a file fails, so the output decides success. `--time` makes it print
  # a line for each file, including files that exceed `--timeout` (30 s), which bounds a runaway parse.
  script/tree-sitter parse --lib-path "$parsers/$grammar" --lang-name "$grammar" -q -s --time --timeout 30000000 \
    --paths "$files" > "$output" || true
  if ! grep -q '^Total parses' "$output"; then
    cat "$output" >&2
    exit 1
  fi
  echo "$grammar: $(grep '^Total parses' "$output")"
  # With an empty known-failures list, a run that parses no file would pass, so every file found must have been parsed.
  local total expected
  total=$(sed -n 's/^Total parses: \([0-9]*\);.*/\1/p' "$output")
  expected=$(grep -c . "$files" || true)
  if [[ $expected == 0 || $total != "$expected" ]]; then
    echo "Parsed $total of $expected example files with $grammar" >&2
    exit 1
  fi
  # A timeout depends on the machine, so it is no expected failure.
  if grep -q 'timed out' "$output"; then
    echo "These files exceeded the parse timeout; $known_file is left unchanged:" >&2
    awk -F '\t' '/timed out/{sub(/ +$/, "", $1); print $1}' "$output" >&2
    exit 1
  fi
  # Each line holds the path, padded with spaces, and the parse results, separated by tabs; some paths contain spaces.
  awk -F '\t' '/ERROR|MISSING/{sub(/ +$/, "", $1); print $1}' "$output" | LC_ALL=C sort > "$failures"
  if [[ $check == true ]]; then
    if ! diff -u "$known_file" "$failures" >&2; then
      echo "The files failing to parse with $grammar differ from $known_file (- fixed, + broken)." >&2
      echo "Run script/parse-examples $grammar to update the list after checking the diff." >&2
      exit 1
    fi
  else
    cp "$failures" "$known_file"
  fi
}

# Synapse keeps the migrations that run on both SQLite and PostgreSQL in .sql files, those for SQLite alone in
# .sql.sqlite files, and those for PostgreSQL alone in .sql.postgres files. Chinook, Quartz, and Spring Batch ship
# scripts per database system.
if should_run sqlite; then
  parse sqlite examples/anki examples/northwind examples/synapse examples/chinook examples/spring-batch \
    \( -name '*.sql' -o -name '*.sql.sqlite' \) \
    \( ! -path 'examples/chinook/*' -o -name 'Chinook_Sqlite*.sql' \) \
    \( ! -path 'examples/spring-batch/*' -o -name '*sqlite*.sql' \)
fi
if should_run postgresql; then
  parse postgresql examples/synapse examples/chinook examples/quartz examples/spring-batch \
    \( -name '*.sql' -o -name '*.sql.postgres' \) \
    \( ! -path 'examples/chinook/*' -o -name 'Chinook_PostgreSql*.sql' \) \
    \( ! -path 'examples/quartz/*' -o -name '*postgres*.sql' \) \
    \( ! -path 'examples/spring-batch/*' -o -name '*postgresql*.sql' \)
fi
if should_run mysql; then
  parse mysql examples/mysql-test-db examples/chinook examples/quartz examples/spring-batch \
    ! -path 'examples/mysql-test-db/postgresql/*' \
    \( -name '*.sql' -o -name '*.dump' \) \
    ! -name 'test_employees_md5.sql' ! -name 'test_employees_sha.sql' ! -name 'employees_partitioned*.sql' \
    \( ! -path 'examples/chinook/*' -o -name 'Chinook_MySql*.sql' \) \
    \( ! -path 'examples/quartz/*' -o -name '*mysql*.sql' \) \
    \( ! -path 'examples/spring-batch/*' -o -name '*mysql*.sql' \)
fi
if should_run oracle; then
  parse oracle examples/oracle-samples examples/chinook examples/quartz examples/spring-batch \
    -name '*.sql' \
    \( ! -path 'examples/chinook/*' -o -name 'Chinook_Oracle*.sql' \) \
    \( ! -path 'examples/quartz/*' -o -name '*oracle*.sql' \) \
    \( ! -path 'examples/spring-batch/*' -o -name '*oracle*.sql' \)
fi
