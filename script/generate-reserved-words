#!/usr/bin/env node
// Prints a C header listing the words of the `window_name` reserved word set in the given grammar.json: the words that
// SQLite's tokenizer does not count as a name when it decides whether a word before them is a keyword.
const fs = require('node:fs');

const grammar = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
// Each reserved word is a pattern listing both cases of each letter, such as `[Aa][Dd][Dd]`.
const words = grammar.reserved.window_name.map(({ value }) => value.replaceAll(/\[([A-Z])[a-z]\]/g, '$1')).sort();
for (const word of words) if (!/^[A-Z_]+$/.test(word)) throw new Error(`Unexpected reserved word pattern: ${word}`);
process.stdout.write(`// Generated by script/generate-reserved-words from grammar.json.
#pragma once

static const char *const NON_NAME_WORDS[] = {
${words.map((word) => `    "${word}",`).join('\n')}
};
`);
