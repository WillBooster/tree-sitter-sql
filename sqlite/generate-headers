#!/usr/bin/env node
// Writes sqlite/src/reserved_words.h listing the words of the `window_name` reserved word set in
// sqlite/src/grammar.json: the words that SQLite's tokenizer does not count as a name when it decides whether a word
// before them is a keyword.
import fs from 'node:fs';
import path from 'node:path';

const grammarDir = import.meta.dirname;
const grammar = JSON.parse(fs.readFileSync(path.join(grammarDir, 'src/grammar.json'), 'utf8'));
// Each reserved word is a pattern listing both cases of each letter, such as `[Aa][Dd][Dd]`.
const words = grammar.reserved.window_name
  .map(/** @param {{ value: string }} entry */ ({ value }) => value.replaceAll(/\[([A-Z])[a-z]\]/g, '$1'))
  .toSorted();
for (const word of words) if (!/^[A-Z_]+$/.test(word)) throw new Error(`Unexpected reserved word pattern: ${word}`);
fs.writeFileSync(
  path.join(grammarDir, 'src/reserved_words.h'),
  `// Generated by sqlite/generate-headers from grammar.json.
#pragma once

static const char *const NON_NAME_WORDS[] = {
${words.map(/** @param {string} word */ (word) => `    "${word}",`).join('\n')}
};
`
);
